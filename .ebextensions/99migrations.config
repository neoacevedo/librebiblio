files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_migrations.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/usr/bin/env bash
      . /opt/elasticbeanstalk/support/envvars
      /usr/bin/composer.phar install -d $EB_CONFIG_APP_CURRENT
      /usr/bin/php /var/app/current/init --env=Production --overwrite=n && /usr/bin/php /var/app/current/yii migrate --interactive=0
      /usr/bin/php /var/app/current/yii migrate/up --interactive=0 --migrationPath=@yii/rbac/migrations
