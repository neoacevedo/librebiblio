files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_migrations.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      . /opt/elasticbeanstalk/support/envvars
      /usr/bin/php $EB_CONFIG_APP_CURRENT/init --env=Production --overwrite=n
      /usr/bin/php $EB_CONFIG_APP_CURRENT/yii migrate --interactive=0

