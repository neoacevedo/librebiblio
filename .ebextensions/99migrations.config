files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_migrations.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/usr/bin/env bash
      . /opt/elasticbeanstalk/support/envvars
      /usr/bin/composer.phar install -d $EB_CONFIG_APP_CURRENT
      cd $EB_CONFIG_APP_CURRENT
      /usr/bin/php init --env=Production --overwrite=n && /usr/bin/php yii migrate --interactive=0

